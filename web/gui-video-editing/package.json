{
  "name": "trd-gui-video-editing-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build ../../crates/trd-wasm --mode no-install --target web --out-dir ../../web/gui-video-editing/pkg",
    "build:web": "bun build ./index.html --outdir dist",
    "build": "bun run build:wasm && bun run build:web",
    "dev": "bun run build:wasm && BUN_PORT=8085 bun ./index.html",
    "typecheck": "tsc --noEmit",
    "check": "biome ci .",
    "format": "biome format --write .",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/bun": "^1.3.14",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "mediabunny": "^1.53.0",
    "mp4box": "^2.4.1"
  }
}
