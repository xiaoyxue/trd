{
  "name": "trd-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build ../crates/trd-wasm --mode no-install --target web --out-dir pkg",
    "build:web": "bun build ./index.html --outdir dist",
    "build": "bun run build:wasm && bun install --frozen-lockfile && bun run build:web",
    "dev": "bun run build && BUN_PORT=8080 bun ./index.html",
    "typecheck": "tsc --noEmit",
    "check": "biome ci .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "apache-arrow": "21.1.0",
    "trd-wasm": "file:../crates/trd-wasm/pkg"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "typescript": "^5.6.0"
  }
}
