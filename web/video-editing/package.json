{
  "name": "trd-video-editing-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "bun run --cwd ../gui-viewer build:wasm",
    "build:web": "bun build ./index.html --outdir dist",
    "build": "bun run build:wasm && bun run build:web",
    "dev": "bun run build:wasm && BUN_PORT=8085 bun ./index.html",
    "typecheck": "tsc --noEmit",
    "check": "biome ci .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "typescript": "^5.6.0"
  }
}
