{
  "name": "trd-gui-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build .. --mode no-install --target web --out-dir web/pkg",
    "build:web": "bun build ./index.html --outdir dist",
    "build": "bun run build:wasm && bun run build:web",
    "dev": "bun run build:wasm && bun run serve.ts",
    "serve": "bun run serve.ts",
    "typecheck": "tsc --noEmit",
    "check": "biome ci .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "typescript": "^5.6.0"
  }
}
